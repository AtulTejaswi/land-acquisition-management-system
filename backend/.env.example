[TEMPLATE]
DATABASE_URL=postgresql+asyncpg://nlams:nlams_secret_2024@localhost:5432/nlams_db
SYNC_DATABASE_URL=postgresql://nlams:nlams_secret_2024@localhost:5432/nlams_db
SECRET_KEY=change-this-to-a-random-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
UPLOAD_DIR=./uploads
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
# Production: replace with your actual domain(s)
# CORS_ORIGINS=["https://nlams.example.gov.in","https://admin.nlams.example.gov.in"]
ENVIRONMENT=development
# Encryption key for sensitive fields (generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
# ENCRYPTION_KEY=
# Sentry DSN for error tracking (leave blank to disable)
# SENTRY_DSN=
# SMS provider: "mock" or "msg91"
# SMS_PROVIDER=mock
# MSG91_API_KEY=
