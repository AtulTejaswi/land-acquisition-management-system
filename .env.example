[TEMPLATE]
# Backend
DATABASE_URL=postgresql+asyncpg://nlams:nlams_secret_2024@localhost:5432/nlams_db
SYNC_DATABASE_URL=postgresql://nlams:nlams_secret_2024@localhost:5432/nlams_db
